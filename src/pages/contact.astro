---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact | Pavan Kumar DG" activePage="contact">
  <div class="container">
    <section class="hero--page">
      <p class="section__eyebrow">Contact</p>
      <h1 class="hero__title">Get in Touch</h1>
      <p class="hero__subtitle">
        Open to conversations about documentation leadership, platform strategy, and
        AI-assisted documentation workflows.
      </p>
      <p style="margin-top: 1rem;">
        <a href="/Pavan_Kumar_Resume.pdf" download class="btn btn--primary">Download resume (PDF)</a>
      </p>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="contact-methods">
        <a href="mailto:pavandg2006@gmail.com" class="contact-card" style="text-decoration:none;">
          <p class="contact-card__label">Email</p>
          <p class="contact-card__value">pavandg2006@gmail.com</p>
        </a>
        <a href="https://www.linkedin.com/in/pavan-kumar-dharmavaram-giridhar/" target="_blank" rel="noopener" class="contact-card" style="text-decoration:none;">
          <p class="contact-card__label">LinkedIn</p>
          <p class="contact-card__value">Pavan Kumar DG</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
