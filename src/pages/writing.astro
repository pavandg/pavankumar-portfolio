---
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = [
  {
    slug: "how-i-use-ai-for-docs-ops",
    title: "How I Use AI for Documentation Operations",
    date: "March 2026",
    summary: "A practical walkthrough of using AI-assisted workflows for code-level analysis, documentation auditing, and release communication.",
  },
  {
    slug: "generate-html-from-rest-using-github-actions",
    title: "Generate HTML from reST Using Sphinx and GitHub Actions",
    date: "2023",
    summary: "How to build a CI/CD pipeline that automatically generates and deploys documentation from reStructuredText to AWS S3.",
  },
  {
    slug: "creating-documentation-homepage-with-restructuredtext",
    title: "Creating a Captivating Documentation Homepage with reStructuredText",
    date: "2021",
    summary: "A reusable template for building well-structured documentation homepages using sphinx-design cards, tabs, and grids.",
  },
  {
    slug: "adding-custom-menu-items-to-readthedocs-header",
    title: "Adding Custom Menu Items to Your Documentation Site Header",
    date: "2023",
    summary: "How to inject custom navigation menus into ReadTheDocs-themed documentation sites using JavaScript.",
  },
  {
    slug: "dita-from-framemaker",
    title: "DITA from FrameMaker: Two Schools of Thought",
    date: "2019",
    summary: "Comparing two approaches to DITA conversion from unstructured FrameMaker, and why full conversion worked better for content reuse.",
  },
  {
    slug: "customizing-changelist-description-in-perforce",
    title: "Customizing Changelist Description in Perforce",
    date: "2022",
    summary: "A client-side Python script to add structured changelist templates in Perforce when server-side triggers are restricted.",
  },
];
---

<BaseLayout title="Writing | Pavan Kumar DG" activePage="writing">
  <div class="container--wide">
    <section class="hero--page">
      <p class="section__eyebrow">Blog</p>
      <h1 class="hero__title">Writing</h1>
      <p class="hero__subtitle">
        Lessons learned from building documentation systems at enterprise scale.
      </p>
    </section>

    <section class="section" style="padding-top: 0;">
      <div class="card-grid card-grid--2">
        {posts.map((post) => (
          <a href={`/posts/${post.slug}`} class="card" style="text-decoration:none;">
            <p class="case-study-header__meta">{post.date}</p>
            <h3 class="card__title">{post.title}</h3>
            <p class="card__desc">{post.summary}</p>
            <span class="card__link">Read post &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
