---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About | Pavan Kumar DG" activePage="about">
  <div class="container">
    <section class="hero">
      <h1 class="hero__title">About Me</h1>
      <p class="hero__subtitle">
        Documentation platform and enablement leader with 13.5+ years of experience driving
        scalable documentation and customer adoption across complex enterprise software and
        cybersecurity platforms.
      </p>
    </section>

    <section class="section">
      <div class="prose">
        <p>
          I specialize in building modular, automated documentation ecosystems aligned with
          product releases, deployment workflows, and customer success outcomes. My work sits at
          the intersection of documentation strategy, automation, and product enablement.
        </p>
        <p>
          I collaborate closely with product, engineering, support, and solutions teams to
          improve usability, onboarding, and self-service success. I actively leverage AI-assisted
          workflows and code-level analysis to automate documentation tasks, accelerate delivery,
          and improve technical accuracy.
        </p>
      </div>
    </section>

    <section class="section">
      <h2>Core Capabilities</h2>
      <div class="about-grid">
        <div class="about-section">
          <h3>Strategy and Architecture</h3>
          <ul>
            <li>Documentation platform strategy and architecture</li>
            <li>Information architecture and content scalability</li>
            <li>Docs-as-Code and modular documentation systems</li>
          </ul>
        </div>
        <div class="about-section">
          <h3>Automation and Delivery</h3>
          <ul>
            <li>Documentation automation and publishing pipelines</li>
            <li>AI-assisted documentation automation</li>
            <li>Agile and release-driven documentation delivery</li>
          </ul>
        </div>
        <div class="about-section">
          <h3>Enablement</h3>
          <ul>
            <li>Product and customer enablement documentation</li>
            <li>Knowledge base and support enablement</li>
            <li>Developer and integration documentation</li>
          </ul>
        </div>
        <div class="about-section">
          <h3>Technical Depth</h3>
          <ul>
            <li>Code analysis for documentation accuracy</li>
            <li>Deployment and troubleshooting documentation</li>
            <li>Product release documentation ownership</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Tools and Technologies</h2>
      <div class="about-grid">
        <div class="about-section">
          <h3>Authoring and Markup</h3>
          <ul>
            <li>Archbee, MadCap Flare, Sphinx, Oxygen XML</li>
            <li>Markdown, reStructuredText, HTML, XML</li>
            <li>DITA, Component-based Authoring</li>
          </ul>
        </div>
        <div class="about-section">
          <h3>Version Control and Automation</h3>
          <ul>
            <li>GitHub, GitLab, Perforce</li>
            <li>Jenkins, GitHub Actions</li>
            <li>Python automation scripts</li>
          </ul>
        </div>
        <div class="about-section">
          <h3>Workflow and Collaboration</h3>
          <ul>
            <li>JIRA, Confluence</li>
            <li>Slack, Cross-functional collaboration</li>
            <li>AI-assisted tooling (Cursor, LLM workflows)</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Career Timeline</h2>
      <div class="card-grid">
        <div class="card">
          <span class="card__tag">2025 - Present</span>
          <h3 class="card__title">Manager, Technical Publications</h3>
          <p class="card__desc">Swimlane &middot; Hyderabad, India</p>
        </div>
        <div class="card">
          <span class="card__tag">2024 - 2025</span>
          <h3 class="card__title">Senior Technical Writer</h3>
          <p class="card__desc">Swimlane &middot; Hyderabad, India</p>
        </div>
        <div class="card">
          <span class="card__tag">2015 - 2024</span>
          <h3 class="card__title">Staff Technical Writer</h3>
          <p class="card__desc">Synopsys &middot; Hyderabad, India</p>
        </div>
        <div class="card">
          <span class="card__tag">2014 - 2015</span>
          <h3 class="card__title">Associate Technical Writer</h3>
          <p class="card__desc">Oracle &middot; Hyderabad, India</p>
        </div>
        <div class="card">
          <span class="card__tag">2013 - 2014</span>
          <h3 class="card__title">Technical Writer Analyst</h3>
          <p class="card__desc">Dell &middot; Bangalore, India</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
