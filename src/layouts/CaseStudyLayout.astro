---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  summary: string;
  date: string;
  tags: string[];
  role: string;
}

const { title, summary, date, tags, role } = Astro.props;
---

<BaseLayout title={`${title} | Pavan Kumar DG`} description={summary} activePage="work">
  <div class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <a href={withBase("/work")} class="back-link">&larr; All Work</a>

    <div class="case-study-header">
      <div style="display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: start;">
        <div>
          <p class="case-study-header__meta">{role}</p>
          <h1>{title}</h1>
          <p style="font-size: 1.08rem; margin-top: 0.75rem; line-height: 1.7;">{summary}</p>
          <div class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
        <div class="about-section" style="min-width: 180px; margin-top: 0.5rem;">
          <h3 style="font-size: 0.85rem; margin-bottom: 0.75rem;">Details</h3>
          <ul style="font-size: 0.82rem;">
            <li>{date}</li>
            <li>{role}</li>
          </ul>
        </div>
      </div>
    </div>

    <article class="prose">
      <slot />
    </article>
  </div>
</BaseLayout>
