---
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description = "Documentation Platform and Enablement Leader", activePage = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={`https://pavandg.github.io${withBase("/")}`} />
  </head>
  <body>
    <nav class="nav">
      <div class="nav__inner">
        <a href="https://pavandg.github.io/pavankumar-portfolio/" class="nav__brand">Pavan Kumar DG</a>
        <ul class="nav__links">
          <li><a href={withBase("/")} class={activePage === "home" ? "active" : ""}>Home</a></li>
          <li><a href={withBase("/work")} class={activePage === "work" ? "active" : ""}>Work</a></li>
          <li><a href={withBase("/writing")} class={activePage === "writing" ? "active" : ""}>Writing</a></li>
          <li><a href={withBase("/about")} class={activePage === "about" ? "active" : ""}>About</a></li>
          <li><a href={withBase("/contact")} class={activePage === "contact" ? "active nav__cta" : "nav__cta"}>Contact</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner">
        <div>
          <span class="footer__name">Pavan Kumar DG</span>
          <span class="footer__tagline">Documentation platform leader · Hyderabad, India</span>
        </div>
        <div class="footer__links">
          <a href="https://www.linkedin.com/in/pavan-kumar-dharmavaram-giridhar/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:pavandg2006@gmail.com">Email</a>
          <a href={withBase("/work")}>Work</a>
        </div>
      </div>
      <p class="footer__disclaimer">© {new Date().getFullYear()} · Selected details generalized for confidentiality.</p>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
