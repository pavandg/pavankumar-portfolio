---
interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description = "Documentation Platform and Enablement Leader", activePage = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="nav">
      <div class="nav__inner">
        <a href="/" class="nav__logo">Pavan Kumar DG</a>
        <ul class="nav__links">
          <li><a href="/" class={activePage === "home" ? "active" : ""}>Home</a></li>
          <li><a href="/work" class={activePage === "work" ? "active" : ""}>Work</a></li>
          <li><a href="/writing" class={activePage === "writing" ? "active" : ""}>Writing</a></li>
          <li><a href="/about" class={activePage === "about" ? "active" : ""}>About</a></li>
          <li><a href="/contact" class={activePage === "contact" ? "active" : ""}>Contact</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>
          <a href="https://www.linkedin.com/in/pavan-kumar-dharmavaram-giridhar/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:pavandg2006@gmail.com">Email</a>
        </p>
        <p style="margin-top: 0.75rem;">Selected details are generalized for confidentiality.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
